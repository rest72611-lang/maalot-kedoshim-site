{
  "name": "maalot-kedoshim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --outDir .cache/build && tsc -p tsconfig.client.json && node .cache/build/build/build.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test test/build-output.test.ts",
    "test:e2e": "tsc -p tsconfig.test.json && node --test test/e2e/*.e2e.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.2"
  }
}
